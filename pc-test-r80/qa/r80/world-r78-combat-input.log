        "hotbar": "",
        "help": "",
        "native": "ev=>{if(['INPUT','TEXTAREA','SELECT'].includes(ev.target?.tagName)||ev.target?.isContentEditable||ev.target?.closest?.('[contenteditable]'))return;const key=ev.key.toLowerCase();if(storyScene){if(ev.key==='Enter'&&!ev.repeat){ev.preventDefault();advanceScene()}return}if(ev.key==='Escape'){ev.preventDefault();if(loading)return;if(!started)return;if(modal)closePanel();else showMenu();return}if(modal||loading||!started)return;unlockAudio();if(ev.key.startsWith('Arrow')){ev.preventDefault();keys.add(ev.key);return}if(key==='a'||key==='1'){ev.preventDefault();keys.add('attack');if(!ev.repeat)basicAttack(true);return}if(ev.repeat)return;if(key==='s'||key==='2'){ev.preventDefault();blink()}else if(key==='d'||key==='3'){ev.preventDefault();guardStart()}else if(key==='q'||key==='4'){ev.preventDefault();special()}else if(key==='f'||key==='5'){ev.preventDefault();ego()}else if(key==='e'){ev.preventDefault();interact()}else if(ev.code==='Space'){ev.preventDefault();auto=!auto;updateHUD()}else if(key==='m'){ev.preventDefault();showWorld()}else if(key==='p'){ev.preventDefault();showUpgrades()}}",
        "pc": "e=>{\n  if(editing(e)||!started||modal||loading||storyScene)return;\n  const key=e.key.toLowerCase();\n  // The preserved game owns arrows for movement and A/1 for basic attack.\n  // J is an extra PC alias. Do not map A to left movement here: that capture\n  // used to swallow the native basic-attack binding.\n  if(key==='j'){e.preventDefault();e.stopImmediatePropagation();keys.add('attack');if(!e.repeat)basicAttack(true);}\n }"
      }
    },
